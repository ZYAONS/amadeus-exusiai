node_modules/
dist/
.env
.env.local

# python 缓存与虚拟环境（venv 里有几百 MB 的依赖）
__pycache__/
*.pyc
.venv/

# 素材不入库：立绘/语音/头像的著作权不是本项目的，仓库只存地址与 SHA-256
public/assets/
_ref/
*.log
.*.tmpdir/

# 作者的 .blend 与导出的 GLB：体积大，著作权也不在本项目
mod/
*.blend
*.glb

# 单文件可执行程序：中间产物和 90MB 的产物都不进仓库，产物走 GitHub Release
build/
*.exe
*.blob

