{
  "name": "amadeus-exusiai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AMADEUS // TERRA — 新约能天使版本的多模态 AI 伴侣（模仿 ai-poet/amadeus-system-new）",
  "scripts": {
    "dev": "vite",
    "dev:api": "node service/server.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "setup": "node tools/build-voice-data.mjs && node tools/fetch-assets.mjs",
    "model": "node tools/fetch-model.mjs",
    "model:demo": "node tools/make-demo-model.mjs",
    "check": "node tools/check.mjs",
    "dev:webrtc": "node tools/run-webrtc.mjs",
    "voice:setup": "python -m venv service/webrtc/.venv && service/webrtc/.venv/Scripts/python.exe -m pip install -r service/webrtc/requirements.txt",
    "voice:fixture": "service/webrtc/.venv/Scripts/python.exe service/webrtc/make_fixture.py",
    "exe": "node tools/build-exe.mjs",
    "release": "python tools/release-exe.py"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "postject": "^1.0.0-alpha.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
