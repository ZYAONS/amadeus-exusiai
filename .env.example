# AMADEUS // TERRA 服务端配置
# 不配也能跑：前端会进入「本地人格模式」，语音走本地 Whisper 与 edge-tts

# ---- 大模型（任意 OpenAI 兼容端点）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
AI_MODEL=deepseek-chat

# ---- WebRTC 语音服务（service/webrtc，npm run dev:webrtc）----
WEBRTC_PORT=8001
WHISPER_LOCAL_MODEL=tiny            # 本地 Whisper 模型：tiny/base/small（自动下载，缓存在 HF_HOME）
WHISPER_LOCAL_COMPUTE=int8
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural # 本地合成音色（edge-tts，不需要 key）
# 配了就优先用云端 Whisper，不配则用本地 faster-whisper
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
# 配了就用 SiliconFlow 合成（可用自定义音色），不配则用 edge-tts
SILICONFLOW_API_KEY=
SILICONFLOW_VOICE=
SILICONFLOW_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
# VAD 断句参数（默认按真人说话调的；自检会临时收紧）
# VAD_RMS=900
# VAD_SILENCE_MS=700
# VAD_MIN_SPEECH_MS=240
# VAD_MAX_SEGMENT_MS=8000
# 强制 ASR/TTS 走 stub（仅在既没模型也没网络时用）
# AMADEUS_FORCE_STUB=1

PORT=3002
