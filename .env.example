# AMADEUS // TERRA 服务端配置
# 不配也能跑：前端会进入「本地人格模式」，语音走浏览器自带的识别与合成
# 配置后 `npm run dev:api`，前端右上角会显示已连接

# ---- 大模型（任意 OpenAI 兼容端点）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
AI_MODEL=deepseek-chat

# ---- WebRTC 语音服务（service/webrtc/server.py，npm run dev:webrtc）----
WEBRTC_PORT=8001
# Whisper 或任何 OpenAI 兼容的 /audio/transcriptions；不填则走 stub（转写固定一句）
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
# 硅基流动 TTS：把回复合成成语音，音色填你自己的 voice id
SILICONFLOW_API_KEY=
SILICONFLOW_VOICE=
SILICONFLOW_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
# VAD 断句参数（默认按真人说话调的；自检会临时收紧）
# VAD_RMS=900
# VAD_SILENCE_MS=700
# VAD_MIN_SPEECH_MS=240
# VAD_MAX_SEGMENT_MS=8000
# 强制 ASR/TTS 走 stub（自检用它保证可复现）
# AMADEUS_FORCE_STUB=1

PORT=3002
